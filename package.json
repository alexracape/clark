{
  "name": "clark",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot index.ts",
    "dev:cli": "bun --hot index.ts",
    "dev:gui": "cd gui && bun run dev",
    "dev:sidecar": "bun gui/sidecar.ts",
    "build": "bun scripts/build.ts",
    "build:gui": "cd gui && bun run build",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "tauri": "cd tauri && cargo tauri",
    "tauri:dev": "cd tauri && cargo tauri dev",
    "start": "bun index.ts",
    "debug:prompt": "bun scripts/debug-system-prompt.ts",
    "test": "CLARK_WORKSPACE_DIR=./test/test_vault bun test",
    "test:core": "CLARK_WORKSPACE_DIR=./test/test_vault bun test ./test/canvas-name.test.ts ./test/canvas-page-autocreate.test.ts ./test/command-router.test.ts ./test/config.test.ts ./test/conversation.test.ts ./test/engine.test.ts ./test/error-scenarios.test.ts ./test/frame-heuristics.test.ts ./test/ingest.test.ts ./test/input.test.ts ./test/library.test.ts ./test/llm.test.ts ./test/mcp-in-process.test.ts ./test/mcp-integration.test.ts ./test/mcp.test.ts ./test/ocr-benchmark.test.ts ./test/onboarding.test.tsx ./test/secret-store-backends.test.ts ./test/tui.test.tsx ./test/upgrade.test.ts --timeout 30000",
    "test:sidecar-contract": "CLARK_WORKSPACE_DIR=./test/test_vault bun test ./test/sidecar-contract.test.ts --timeout 30000",
    "test:gui-controller": "CLARK_WORKSPACE_DIR=./test/test_vault bun test ./test/gui-controller.test.ts --timeout 30000",
    "test:rust-contract": "cargo test --manifest-path tauri/Cargo.toml",
    "test:refactor-fast": "bun run test:core && bun run test:sidecar-contract && bun run test:gui-controller && bun run test:rust-contract",
    "test:desktop-smoke": "CLARK_WORKSPACE_DIR=./test/test_vault bun test ./test/desktop-smoke.test.ts --timeout 30000",
    "bench:pdf-ocr": "bun scripts/benchmark-pdf-transcription.ts",
    "mcp": "bun core/mcp/standalone.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun core/mcp/standalone.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^1.40.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@tauri-apps/api": "^2.10.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/markdown": "^3.20.1",
    "@tldraw/sync": "^4.1.2",
    "@tldraw/sync-core": "^4.3.1",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "ollama": "^0.6.3",
    "openai": "^4.86.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^4.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/yargs": "^17.0.33",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
